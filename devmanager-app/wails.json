{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "devManager",
  "outputfilename": "devmanager",
  "frontend": {
    "dir": "./frontend",
    "install": "npm install",
    "build": "npm run build",
    "dev": "npm run dev",
    "package": {
      "manager": "npm"
    }
  },
  "backend": {
    "dir": "./",
    "go": {
      "main": "./main.go",
      "ldflags": "-s -w"
    }
  },
  "author": {
    "name": "d-l-n",
    "email": "dylan.partemi@example.com"
  },
  "info": {
    "productName": "devManager",
    "productVersion": "1.0.1",
    "copyright": "Copyright © 2025 d-l-n",
    "comments": "Gestor de proyectos de desarrollo local"
  },
  "nsisType": "multiple",
  "obfuscated": false,
  "garbleargs": "",
  "upx": false,
  "upxflags": "",
  "runNonNativeBuildHooks": false,
  "windowStartState": "normal",
  "assetdir": "./frontend/dist",
  "reloaddirs": "./frontend",
  "builddir": "./build",
  "devServer": "localhost:34115",
  "frontendDevServerURL": "http://localhost:5173",
  "garbleLinker": false,
  "platform": "build",
  "arch": "build",
  "ldflags": [],
  "tags": [],
  "cgo": false,
  "race": false,
  "frontendDevServerTimeout": 10000,
  "windowWidth": 1200,
  "windowHeight": 800,
  "minWindowWidth": 800,
  "minWindowHeight": 600,
  "disableResize": false,
  "fullscreen": false,
  "startHidden": false,
  "hideWindowOnClose": false,
  "webviewType": "",
  "webviewUserDataPath": "",
  "webviewBrowserPath": "",
  "debug": false,
  "singleInstanceLock": true,
  "logLevel": "INFO",
  "logFile": "",
  "logWails": false,
  "errorExternal": false,
  "redirectStdio": false,
  "remoteDebugging": true,
  "openDevToolsInDebug": false,
  "colorScheme": "dark",
  "windowIsTranslucent": false,
  "windowIsDecorated": true,
  "windowBackgroundColour": "#0c0e17",
  "windowIsAlwaysOnTop": false,
  "windowIsClosable": true,
  "windowIsMinimizable": true,
  "windowIsMaximizable": true,
  "windowCanDrag": false,
  "windowCanResize": true,
  "assets": {
    "files": {
      "": "./frontend/dist"
    }
  }
}
